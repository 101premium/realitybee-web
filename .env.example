# Template for .env — copy with `cp .env.example .env` and fill in the blanks.
#
# VITE_-prefixed vars are inlined into the CLIENT bundle — never put secrets there.
# Unprefixed vars are server-only and stay on the server.

# ---------------------------------------------------------------------------
# Cart API (public, called directly from the browser) — src/lib/api.ts
# ---------------------------------------------------------------------------
# Use http://localhost:8087 when running the cart service locally.
VITE_API_BASE_URL=https://cart.realitybee.com.ng

# ---------------------------------------------------------------------------
# Order / payment middleware (Basic auth, proxied server-side) — src/lib/order-api.ts
# ---------------------------------------------------------------------------
# The browser never talks to this host directly; server functions forward to it.
ORDER_API_URL=https://payments.realitybee.com.ng

# Basic-auth credentials for the middleware. Leave blank here; set real values in
# .env locally and in Railway's variables for production.
MIDDLEWARE_USER=
MIDDLEWARE_PASS=

# AES key for encrypting card data before it is sent to the gateway. Secret.
PAYMENT_SECRET_KEY=

# Merchant identity sent with every order/payment. Not secret, but server-side so
# a client cannot bill a different merchant.
MERCHANT_ID=SCHKGWUF
COMPANY_NAME=OPTIMUM-SYSTEM
