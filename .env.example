# Template for .env — copy with `cp .env.example .env` and adjust locally.
# Only VITE_-prefixed vars are exposed to client code, so never put secrets here.

# Base URL of the Reality Bee shopping-cart API (Spring Boot service).
# Defaults to the production host in src/lib/api.ts when unset.
# Use http://localhost:8087 when running the cart service locally.
VITE_API_BASE_URL=https://cart.realitybee.com.ng
